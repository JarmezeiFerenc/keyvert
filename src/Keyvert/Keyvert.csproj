<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyName>Keyvert</AssemblyName>
    <Product>Keyvert</Product>
    <AssemblyTitle>Keyvert</AssemblyTitle>
    <Description>Use your keyboard as a virtual Xbox controller.</Description>
    <Version>1.0.0</Version>
    <Authors>JarmezeiFerenc</Authors>
    <Copyright>Copyright (c) 2026 JarmezeiFerenc</Copyright>
    <RepositoryUrl>https://github.com/JarmezeiFerenc/keyvert</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms is only used for the tray icon and the Keys enum; keep its names out of WPF code. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\app.png" />
    <Resource Include="Assets\tray_on.ico" />
    <Resource Include="Assets\tray_off.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Nefarius.ViGEm.Client" Version="1.21.256" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

</Project>
