<ui:FluentWindow
    x:Class="Keyvert.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:Keyvert.Views"
    xmlns:vm="clr-namespace:Keyvert.ViewModels"
    Title="Keyvert"
    Width="1120"
    Height="760"
    MinWidth="960"
    MinHeight="640"
    d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
    ExtendsContentIntoTitleBar="True"
    Icon="pack://application:,,,/Assets/app.ico"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <views:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <views:NullToCollapsedConverter x:Key="NullToCollapsed" />

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="20" />
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,18,0,8" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="SettingTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="SettingCard" BasedOn="{StaticResource {x:Type ui:CardControl}}" TargetType="ui:CardControl">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Padding" Value="16,12" />
        </Style>
        <Style x:Key="PivotTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle">
                <Setter.Value>
                    <Style>
                        <Setter Property="Control.Template">
                            <Setter.Value>
                                <ControlTemplate>
                                    <Border
                                        Margin="-6,0,18,4"
                                        BorderBrush="{DynamicResource TextFillColorPrimaryBrush}"
                                        BorderThickness="2"
                                        CornerRadius="4" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Margin="0,0,24,0" Background="Transparent">
                            <TextBlock
                                x:Name="Label"
                                Margin="0,4,0,10"
                                Foreground="{TemplateBinding Foreground}"
                                Text="{TemplateBinding Content}" />
                            <Border
                                x:Name="Underline"
                                Width="18"
                                Height="3"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Background="{DynamicResource AccentFillColorDefaultBrush}"
                                CornerRadius="1.5"
                                Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                                <Setter TargetName="Underline" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="Keyvert" Grid.Row="0">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1" Margin="24,4,24,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="440" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Left column: status and live view  -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="10" Height="10" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEmulationOn}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock
                                        Margin="10,0,0,0"
                                        FontSize="20"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        Text="{Binding StatusTitle}" />
                                </StackPanel>
                                <TextBlock Margin="0,6,0,0" Style="{StaticResource Caption}" Text="{Binding StatusDetail}" />
                            </StackPanel>
                            <ui:ToggleSwitch
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Emulation"
                                IsChecked="{Binding IsEmulationOn}"
                                IsEnabled="{Binding IsDriverReady}" />
                        </Grid>

                        <Rectangle Height="1" Margin="0,18,0,14" Fill="{DynamicResource DividerStrokeColorDefaultBrush}" />

                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon FontSize="16">
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon">
                                        <Setter Property="Symbol" Value="ArrowSync24" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDriverReady}" Value="True">
                                                <Setter Property="Symbol" Value="CheckmarkCircle24" />
                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsDriverProblem}" Value="True">
                                                <Setter Property="Symbol" Value="Warning24" />
                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding DriverText}" />
                        </StackPanel>
                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                            <ui:SymbolIcon FontSize="16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Symbol="XboxController24" />
                            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding ControllerText}" />
                        </StackPanel>

                        <StackPanel Margin="0,16,0,0" Orientation="Horizontal" Visibility="{Binding IsDriverProblem, Converter={StaticResource BoolToVisibility}}">
                            <ui:Button Appearance="Primary" Command="{Binding OpenDriverPageCommand}" Content="Download driver" Icon="{ui:SymbolIcon ArrowDownload24}" />
                            <ui:Button Margin="8,0,0,0" Command="{Binding RetryDriverCommand}" Content="Try again" Icon="{ui:SymbolIcon ArrowSync24}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="Live view" />
                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Caption}" Text="{Binding LiveViewHint}" />
                        </DockPanel>
                        <views:ControllerView
                            Grid.Row="1"
                            Margin="0,16,0,0"
                            Highlight="{Binding HighlightedAction}"
                            Snapshot="{Binding Snapshot}" />
                    </Grid>
                </Border>
            </Grid>

            <!--  Right column: profile, bindings and settings  -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Profile" />
                    <ComboBox
                        Grid.Column="1"
                        MaxWidth="320"
                        Margin="12,0,8,0"
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="Profile"
                        ItemsSource="{Binding Profiles}"
                        MinWidth="240"
                        SelectedItem="{Binding SelectedProfile}" />
                    <ui:Button
                        x:Name="ProfileMenuButton"
                        Grid.Column="2"
                        Click="ProfileMenuButton_Click"
                        Content="Manage"
                        Icon="{ui:SymbolIcon MoreHorizontal24}"
                        ToolTip="Profile actions">
                        <ui:Button.ContextMenu>
                            <ContextMenu Placement="Bottom">
                                <MenuItem Command="{Binding NewProfileCommand}" Header="New profile" Icon="{ui:SymbolIcon DocumentAdd24}" />
                                <MenuItem
                                    Click="PresetMenu_Click"
                                    Header="Add a game layout"
                                    Icon="{ui:SymbolIcon Games24}"
                                    ItemsSource="{Binding Presets}">
                                    <MenuItem.ItemContainerStyle>
                                        <Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="MenuItem">
                                            <Setter Property="Header" Value="{Binding Name}" />
                                            <Setter Property="ToolTip" Value="{Binding Description}" />
                                        </Style>
                                    </MenuItem.ItemContainerStyle>
                                </MenuItem>
                                <MenuItem Command="{Binding DuplicateProfileCommand}" Header="Duplicate" Icon="{ui:SymbolIcon Copy24}" />
                                <MenuItem Command="{Binding RenameProfileCommand}" Header="Rename" Icon="{ui:SymbolIcon Rename24}" />
                                <MenuItem Command="{Binding ResetProfileCommand}" Header="Reset layout" Icon="{ui:SymbolIcon ArrowSync24}" />
                                <MenuItem Command="{Binding DeleteProfileCommand}" Header="Delete" Icon="{ui:SymbolIcon Delete24}" />
                                <Separator />
                                <MenuItem Command="{Binding ImportProfileCommand}" Header="Import…" Icon="{ui:SymbolIcon ArrowImport24}" />
                                <MenuItem Command="{Binding ExportProfileCommand}" Header="Export…" Icon="{ui:SymbolIcon ArrowExportLtr24}" />
                                <MenuItem Command="{Binding OpenProfilesFolderCommand}" Header="Open profiles folder" Icon="{ui:SymbolIcon FolderOpen24}" />
                            </ContextMenu>
                        </ui:Button.ContextMenu>
                    </ui:Button>
                </Grid>

                <Grid Grid.Row="1" Margin="0,18,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="BindingsTab" Content="Bindings" GroupName="Pages" IsChecked="True" Style="{StaticResource PivotTab}" />
                        <RadioButton x:Name="SettingsTab" Content="Settings" GroupName="Pages" Style="{StaticResource PivotTab}" />
                    </StackPanel>

                    <ScrollViewer
                        Grid.Row="1"
                        Padding="0,0,14,0"
                        VerticalScrollBarVisibility="Auto"
                        Visibility="{Binding IsChecked, ElementName=BindingsTab, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl Margin="0,0,0,8" ItemsSource="{Binding Groups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:BindingGroupViewModel}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SectionHeader}" Text="{Binding Title}" />
                                            <Border Padding="4" Style="{StaticResource Card}">
                                                <ItemsControl ItemsSource="{Binding Rows}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:BindingRowViewModel}">
                                                            <Border
                                                                x:Name="RowBorder"
                                                                MinHeight="46"
                                                                Padding="12,6,8,6"
                                                                Background="Transparent"
                                                                BorderBrush="Transparent"
                                                                BorderThickness="1"
                                                                CornerRadius="5"
                                                                MouseEnter="Row_MouseEnter"
                                                                MouseLeave="Row_MouseLeave">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="3" />
                                                                        <ColumnDefinition Width="12" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Border
                                                                        Height="18"
                                                                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                                                                        CornerRadius="1.5"
                                                                        Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}" />
                                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
                                                                        <TextBlock FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Name}" />
                                                                        <TextBlock
                                                                            Margin="8,0,0,0"
                                                                            VerticalAlignment="Center"
                                                                            Style="{StaticResource Caption}"
                                                                            Text="{Binding Hint}"
                                                                            Visibility="{Binding Hint, Converter={StaticResource NullToCollapsed}}" />
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="3" VerticalAlignment="Center" Orientation="Horizontal">
                                                                        <TextBlock
                                                                            Margin="0,0,4,0"
                                                                            VerticalAlignment="Center"
                                                                            FontSize="13"
                                                                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                            Text="Not set"
                                                                            Visibility="{Binding HasKeys, Converter={StaticResource InverseBoolToVisibility}}" />
                                                                        <ItemsControl ItemsSource="{Binding Keys}">
                                                                            <ItemsControl.ItemsPanel>
                                                                                <ItemsPanelTemplate>
                                                                                    <StackPanel Orientation="Horizontal" />
                                                                                </ItemsPanelTemplate>
                                                                            </ItemsControl.ItemsPanel>
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate DataType="{x:Type vm:KeyChip}">
                                                                                    <Border
                                                                                        Margin="6,0,0,0"
                                                                                        Padding="10,3,3,3"
                                                                                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                                                        BorderThickness="1,1,1,2"
                                                                                        CornerRadius="5">
                                                                                        <StackPanel Orientation="Horizontal">
                                                                                            <TextBlock
                                                                                                MinWidth="12"
                                                                                                VerticalAlignment="Center"
                                                                                                FontSize="13"
                                                                                                FontWeight="SemiBold"
                                                                                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                                                                Text="{Binding Label}" />
                                                                                            <ui:Button
                                                                                                Width="22"
                                                                                                Height="22"
                                                                                                Margin="6,0,0,0"
                                                                                                Padding="0"
                                                                                                Appearance="Transparent"
                                                                                                AutomationProperties.Name="Remove key"
                                                                                                BorderThickness="0"
                                                                                                Command="{Binding DataContext.RemoveKeyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                                CommandParameter="{Binding}"
                                                                                                ToolTip="Remove">
                                                                                                <ui:SymbolIcon FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Symbol="Dismiss12" />
                                                                                            </ui:Button>
                                                                                        </StackPanel>
                                                                                    </Border>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                        <ui:Button
                                                                            Width="32"
                                                                            Height="32"
                                                                            Margin="6,0,0,0"
                                                                            Padding="0"
                                                                            Appearance="Transparent"
                                                                            AutomationProperties.Name="Add key"
                                                                            BorderThickness="0"
                                                                            Command="{Binding AddKeyCommand}"
                                                                            ToolTip="Add a key">
                                                                            <ui:SymbolIcon FontSize="16" Symbol="Add24" />
                                                                        </ui:Button>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                            <DataTemplate.Triggers>
                                                                <Trigger SourceName="RowBorder" Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                                                </Trigger>
                                                                <DataTrigger Binding="{Binding IsCapturing}" Value="True">
                                                                    <Setter TargetName="RowBorder" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                                </DataTrigger>
                                                            </DataTemplate.Triggers>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                    </ScrollViewer>

                    <ScrollViewer
                        Grid.Row="1"
                        Padding="0,0,14,0"
                        VerticalScrollBarVisibility="Auto"
                        Visibility="{Binding IsChecked, ElementName=SettingsTab, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Style="{StaticResource SectionHeader}" Text="Emulation" />
                                <ui:CardControl Icon="{ui:SymbolIcon Keyboard24}" Style="{StaticResource SettingCard}">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SettingTitle}" Text="On/off hotkey" />
                                            <TextBlock Style="{StaticResource Caption}" Text="Turns emulation on and off from anywhere, even while a game has focus." />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:Button MinWidth="96" AutomationProperties.Name="Change on/off hotkey" Command="{Binding StartToggleKeyCaptureCommand}" Content="{Binding ToggleKeyLabel}" ToolTip="Change the hotkey" />
                                </ui:CardControl>
                                <ui:CardControl Icon="{ui:SymbolIcon Shield24}" Style="{StaticResource SettingCard}">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SettingTitle}" Text="Block mapped keys" />
                                            <TextBlock Style="{StaticResource Caption}" Text="While emulation is on, games get only controller input from mapped keys, not the keys themselves." />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:ToggleSwitch AutomationProperties.Name="Block mapped keys" IsChecked="{Binding SuppressMappedKeys}" />
                                </ui:CardControl>
                                <ui:CardControl Icon="{ui:SymbolIcon Power24}" Style="{StaticResource SettingCard}">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SettingTitle}" Text="Turn on at startup" />
                                            <TextBlock Style="{StaticResource Caption}" Text="Start emulating as soon as the app opens." />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:ToggleSwitch AutomationProperties.Name="Turn on at startup" IsChecked="{Binding EnableOnStartup}" />
                                </ui:CardControl>
                                <ui:CardControl Icon="{ui:SymbolIcon Speaker224}" Style="{StaticResource SettingCard}">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SettingTitle}" Text="Sound on toggle" />
                                            <TextBlock Style="{StaticResource Caption}" Text="A high beep when emulation turns on, a low one when it turns off." />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:ToggleSwitch AutomationProperties.Name="Sound on toggle" IsChecked="{Binding ToggleBeep}" />
                                </ui:CardControl>

                                <TextBlock Style="{StaticResource SectionHeader}" Text="This profile" />
                                <ui:CardControl Icon="{ui:SymbolIcon Games24}" Style="{StaticResource SettingCard}">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SettingTitle}" Text="Walk speed" />
                                            <TextBlock Style="{StaticResource Caption}" Text="How far the left stick tilts while the Walk key is held." />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <Slider
                                            Width="180"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="Walk speed"
                                            IsSnapToTickEnabled="True"
                                            Maximum="100"
                                            Minimum="10"
                                            TickFrequency="5"
                                            Value="{Binding WalkPercent, Delay=150}" />
                                        <TextBlock
                                            Width="44"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                            Text="{Binding WalkPercent, StringFormat={}{0:0}%}"
                                            TextAlignment="Right" />
                                    </StackPanel>
                                </ui:CardControl>

                                <TextBlock Style="{StaticResource SectionHeader}" Text="Window" />
                                <ui:CardControl Icon="{ui:SymbolIcon Open24}" Style="{StaticResource SettingCard}">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SettingTitle}" Text="Keep running when closed" />
                                            <TextBlock Style="{StaticResource Caption}" Text="Closing the window keeps the app in the notification area. Exit from the tray icon." />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:ToggleSwitch AutomationProperties.Name="Keep running when closed" IsChecked="{Binding CloseToTray}" />
                                </ui:CardControl>
                                <ui:CardControl Icon="{ui:SymbolIcon ArrowMinimize24}" Style="{StaticResource SettingCard}">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SettingTitle}" Text="Start in the tray" />
                                            <TextBlock Style="{StaticResource Caption}" Text="Open without showing the window." />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:ToggleSwitch AutomationProperties.Name="Start in the tray" IsChecked="{Binding StartMinimized}" />
                                </ui:CardControl>

                                <TextBlock Style="{StaticResource SectionHeader}" Text="About" />
                                <ui:CardControl Icon="{ui:SymbolIcon XboxController24}" Style="{StaticResource SettingCard}">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SettingTitle}" Text="ViGEmBus driver" />
                                            <TextBlock Style="{StaticResource Caption}" Text="{Binding DriverText}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:Button Command="{Binding OpenDriverPageCommand}" Content="Driver download page" />
                                </ui:CardControl>
                                <ui:CardControl Icon="{ui:SymbolIcon Info24}" Style="{StaticResource SettingCard}">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SettingTitle}" Text="Keyvert" />
                                            <TextBlock Style="{StaticResource Caption}" Text="{Binding Version, StringFormat=Version {0}}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:Button Command="{Binding OpenProfilesFolderCommand}" Content="Profiles folder" />
                                        <ui:Button Margin="8,0,0,0" Command="{Binding OpenLogFolderCommand}" Content="Log folder" />
                                    </StackPanel>
                                </ui:CardControl>
                            </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <!--  Key capture overlay  -->
        <Grid
            Grid.Row="0"
            Grid.RowSpan="2"
            Background="{DynamicResource SmokeFillColorDefaultBrush}"
            MouseDown="CaptureOverlay_MouseDown"
            Visibility="{Binding IsCapturing, Converter={StaticResource BoolToVisibility}}">
            <Border
                Width="380"
                Padding="32,28"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel HorizontalAlignment="Center">
                    <ui:SymbolIcon HorizontalAlignment="Center" FontSize="40" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Symbol="Keyboard24" />
                    <TextBlock
                        Margin="0,14,0,0"
                        HorizontalAlignment="Center"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="Press a key" />
                    <TextBlock
                        Margin="0,6,0,0"
                        HorizontalAlignment="Center"
                        FontSize="14"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="{Binding CaptureTitle, StringFormat=for {0}}" />
                    <TextBlock
                        Margin="0,16,0,0"
                        HorizontalAlignment="Center"
                        Style="{StaticResource Caption}"
                        Text="Every key counts, including Esc. Click anywhere to cancel." />
                    <ui:Button
                        MinWidth="96"
                        Margin="0,16,0,0"
                        HorizontalAlignment="Center"
                        AutomationProperties.Name="Cancel key capture"
                        Command="{Binding CancelCaptureCommand}"
                        Content="Cancel" />
                </StackPanel>
            </Border>
        </Grid>

        <!--  Prompt overlay  -->
        <Grid
            Grid.Row="0"
            Grid.RowSpan="2"
            Background="{DynamicResource SmokeFillColorDefaultBrush}"
            Visibility="{Binding IsPromptOpen, Converter={StaticResource BoolToVisibility}}">
            <Border
                Width="420"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel>
                    <StackPanel Margin="24,22,24,22">
                        <TextBlock
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="{Binding PromptTitle}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Margin="0,8,0,0"
                            FontSize="14"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding PromptMessage}"
                            TextWrapping="Wrap"
                            Visibility="{Binding PromptMessage, Converter={StaticResource NullToCollapsed}}" />
                        <ui:TextBox
                            x:Name="PromptTextBox"
                            Margin="0,16,0,0"
                            AutomationProperties.Name="Name"
                            Text="{Binding PromptText, UpdateSourceTrigger=PropertyChanged}"
                            Visibility="{Binding PromptHasInput, Converter={StaticResource BoolToVisibility}}">
                            <ui:TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding ConfirmPromptCommand}" />
                                <KeyBinding Key="Escape" Command="{Binding CancelPromptCommand}" />
                            </ui:TextBox.InputBindings>
                        </ui:TextBox>
                        <TextBlock
                            Margin="0,8,0,0"
                            FontSize="12"
                            Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                            Text="{Binding PromptError}"
                            TextWrapping="Wrap"
                            Visibility="{Binding PromptError, Converter={StaticResource NullToCollapsed}}" />
                    </StackPanel>
                    <Border
                        Padding="24,20"
                        Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0,0,8,8">
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <ui:Button
                                MinWidth="96"
                                Margin="0,0,8,0"
                                Command="{Binding CancelPromptCommand}"
                                Content="Cancel"
                                Visibility="{Binding PromptShowCancel, Converter={StaticResource BoolToVisibility}}" />
                            <ui:Button
                                MinWidth="96"
                                Command="{Binding ConfirmPromptCommand}"
                                Content="{Binding PromptConfirmText}">
                                <ui:Button.Style>
                                    <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
                                        <Setter Property="Appearance" Value="Primary" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PromptIsDanger}" Value="True">
                                                <Setter Property="Appearance" Value="Danger" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                            </ui:Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!--  Toast  -->
        <Border
            Grid.Row="1"
            MaxWidth="560"
            Margin="0,0,0,28"
            Padding="16,12"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            IsHitTestVisible="False"
            Visibility="{Binding IsToastVisible, Converter={StaticResource BoolToVisibility}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" Opacity="0.28" ShadowDepth="4" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon FontSize="18" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Symbol="Info24" />
                <TextBlock
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="14"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="{Binding ToastText}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
