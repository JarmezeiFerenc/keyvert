<UserControl
    x:Class="Keyvert.Views.ControllerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    SnapsToDevicePixels="False">
    <UserControl.Resources>
        <Style x:Key="Part" TargetType="Shape">
            <Setter Property="Fill" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            <Setter Property="Stroke" Value="{DynamicResource ControlStrongStrokeColorDefaultBrush}" />
            <Setter Property="StrokeThickness" Value="1" />
        </Style>
        <Style x:Key="PartLabel" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style x:Key="FaceLabel" BasedOn="{StaticResource PartLabel}" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style x:Key="ReadoutLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="ReadoutValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
    </UserControl.Resources>

    <Grid VerticalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Viewbox MaxHeight="320" Stretch="Uniform">
            <Canvas Width="440" Height="258">
                <!--  Triggers  -->
                <Grid Canvas.Left="80" Canvas.Top="4" Width="70" Height="26">
                    <Rectangle x:Name="LtBack" RadiusX="8" RadiusY="8" Style="{StaticResource Part}" />
                    <Rectangle x:Name="LtFill" Width="0" HorizontalAlignment="Left" Fill="{DynamicResource AccentFillColorDefaultBrush}" RadiusX="8" RadiusY="8" />
                    <TextBlock x:Name="LtLabel" Style="{StaticResource PartLabel}" Text="LT" />
                </Grid>
                <Grid Canvas.Left="290" Canvas.Top="4" Width="70" Height="26">
                    <Rectangle x:Name="RtBack" RadiusX="8" RadiusY="8" Style="{StaticResource Part}" />
                    <Rectangle x:Name="RtFill" Width="0" HorizontalAlignment="Right" Fill="{DynamicResource AccentFillColorDefaultBrush}" RadiusX="8" RadiusY="8" />
                    <TextBlock x:Name="RtLabel" Style="{StaticResource PartLabel}" Text="RT" />
                </Grid>

                <!--  Bumpers  -->
                <Grid Canvas.Left="66" Canvas.Top="38" Width="96" Height="17">
                    <Rectangle x:Name="LbShape" RadiusX="8.5" RadiusY="8.5" Style="{StaticResource Part}" />
                    <TextBlock x:Name="LbLabel" FontSize="9" Style="{StaticResource PartLabel}" Text="LB" />
                </Grid>
                <Grid Canvas.Left="278" Canvas.Top="38" Width="96" Height="17">
                    <Rectangle x:Name="RbShape" RadiusX="8.5" RadiusY="8.5" Style="{StaticResource Part}" />
                    <TextBlock x:Name="RbLabel" FontSize="9" Style="{StaticResource PartLabel}" Text="RB" />
                </Grid>

                <!--  Body  -->
                <Path
                    Data="M 100,60 C 70,60 50,75 42,105 L 22,190 C 15,225 35,250 65,245 C 85,242 102,225 115,205 C 122,195 135,190 150,190 L 290,190 C 305,190 318,195 325,205 C 338,225 355,242 375,245 C 405,250 425,225 418,190 L 398,105 C 390,75 370,60 340,60 Z"
                    Fill="{DynamicResource ControlFillColorDefaultBrush}"
                    Stroke="{DynamicResource ControlStrongStrokeColorDefaultBrush}"
                    StrokeThickness="1.5" />

                <!--  Left stick  -->
                <Ellipse x:Name="LeftRing" Canvas.Left="96" Canvas.Top="86" Width="58" Height="58" Style="{StaticResource Part}" />
                <Ellipse x:Name="LeftThumb" Canvas.Left="107" Canvas.Top="97" Width="36" Height="36" Style="{StaticResource Part}">
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="LeftThumbOffset" />
                    </Ellipse.RenderTransform>
                </Ellipse>

                <!--  Right stick  -->
                <Ellipse x:Name="RightRing" Canvas.Left="243" Canvas.Top="126" Width="58" Height="58" Style="{StaticResource Part}" />
                <Ellipse x:Name="RightThumb" Canvas.Left="254" Canvas.Top="137" Width="36" Height="36" Style="{StaticResource Part}">
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="RightThumbOffset" />
                    </Ellipse.RenderTransform>
                </Ellipse>

                <!--  D-pad  -->
                <Rectangle Canvas.Left="159" Canvas.Top="146" Width="18" Height="18" Fill="{DynamicResource ControlFillColorSecondaryBrush}" />
                <Rectangle x:Name="DpadUp" Canvas.Left="159" Canvas.Top="127" Width="18" Height="20" RadiusX="3" RadiusY="3" Style="{StaticResource Part}" />
                <Rectangle x:Name="DpadDown" Canvas.Left="159" Canvas.Top="163" Width="18" Height="20" RadiusX="3" RadiusY="3" Style="{StaticResource Part}" />
                <Rectangle x:Name="DpadLeft" Canvas.Left="140" Canvas.Top="146" Width="20" Height="18" RadiusX="3" RadiusY="3" Style="{StaticResource Part}" />
                <Rectangle x:Name="DpadRight" Canvas.Left="176" Canvas.Top="146" Width="20" Height="18" RadiusX="3" RadiusY="3" Style="{StaticResource Part}" />

                <!--  Menu buttons  -->
                <Ellipse x:Name="BackShape" Canvas.Left="184" Canvas.Top="108" Width="15" Height="15" Style="{StaticResource Part}" />
                <Ellipse x:Name="StartShape" Canvas.Left="241" Canvas.Top="108" Width="15" Height="15" Style="{StaticResource Part}" />
                <Grid Canvas.Left="206" Canvas.Top="74" Width="28" Height="28">
                    <Ellipse x:Name="GuideShape" Style="{StaticResource Part}" />
                    <Ellipse Width="12" Height="12" Stroke="{DynamicResource TextFillColorTertiaryBrush}" StrokeThickness="2" IsHitTestVisible="False" />
                </Grid>

                <!--  Face buttons  -->
                <Grid Canvas.Left="317" Canvas.Top="80" Width="24" Height="24">
                    <Ellipse x:Name="YShape" />
                    <TextBlock x:Name="YLabel" Style="{StaticResource FaceLabel}" Text="Y" />
                </Grid>
                <Grid Canvas.Left="317" Canvas.Top="126" Width="24" Height="24">
                    <Ellipse x:Name="AShape" />
                    <TextBlock x:Name="ALabel" Style="{StaticResource FaceLabel}" Text="A" />
                </Grid>
                <Grid Canvas.Left="294" Canvas.Top="103" Width="24" Height="24">
                    <Ellipse x:Name="XShape" />
                    <TextBlock x:Name="XLabel" Style="{StaticResource FaceLabel}" Text="X" />
                </Grid>
                <Grid Canvas.Left="340" Canvas.Top="103" Width="24" Height="24">
                    <Ellipse x:Name="BShape" />
                    <TextBlock x:Name="BLabel" Style="{StaticResource FaceLabel}" Text="B" />
                </Grid>
            </Canvas>
        </Viewbox>

        <Grid Grid.Row="1" Margin="4,28,4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Column="0" Margin="0,0,0,6" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="Left stick" />
            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource ReadoutLabel}" Text="X" />
            <TextBlock x:Name="LeftXText" Grid.Row="1" Grid.Column="0" Style="{StaticResource ReadoutValue}" Text="0" />
            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource ReadoutLabel}" Text="Y" />
            <TextBlock x:Name="LeftYText" Grid.Row="2" Grid.Column="0" Style="{StaticResource ReadoutValue}" Text="0" />

            <TextBlock Grid.Column="2" Margin="0,0,0,6" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="Right stick" />
            <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource ReadoutLabel}" Text="X" />
            <TextBlock x:Name="RightXText" Grid.Row="1" Grid.Column="2" Style="{StaticResource ReadoutValue}" Text="0" />
            <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource ReadoutLabel}" Text="Y" />
            <TextBlock x:Name="RightYText" Grid.Row="2" Grid.Column="2" Style="{StaticResource ReadoutValue}" Text="0" />

            <TextBlock Grid.Column="4" Margin="0,0,0,6" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="Triggers" />
            <TextBlock Grid.Row="1" Grid.Column="4" Style="{StaticResource ReadoutLabel}" Text="Left" />
            <TextBlock x:Name="LtText" Grid.Row="1" Grid.Column="4" Style="{StaticResource ReadoutValue}" Text="0%" />
            <TextBlock Grid.Row="2" Grid.Column="4" Style="{StaticResource ReadoutLabel}" Text="Right" />
            <TextBlock x:Name="RtText" Grid.Row="2" Grid.Column="4" Style="{StaticResource ReadoutValue}" Text="0%" />
        </Grid>
    </Grid>
</UserControl>
